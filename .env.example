# Copy to .env.local for local development. On Hostinger set these in the Node.js app's
# "Environment variables" panel. Everything is optional — the defaults work out of the box.

# ---- Where the database and uploaded files live -------------------------------------------
# Default: ./data inside the project. On the server, point this OUTSIDE the app folder so a
# redeploy can never overwrite your content, e.g.  DATA_DIR=/home/u123456/dassrebar-data
# DATA_DIR=

# ---- Public site URL (used for absolute links in metadata / emails) -----------------------
# SITE_URL=https://dassrebar.com

# ---- Email notifications for new form submissions (optional) ------------------------------
# Create a mailbox in hPanel (Emails) and use its details. Recipients are set in Studio CMS > Settings.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=forms@yourdomain.com
# SMTP_PASS=
# MAIL_FROM="Dass Rebar <forms@yourdomain.com>"

# ---- Only if needed ------------------------------------------------------------------------
# If saving in Studio CMS fails with "Invalid Server Actions request" behind the host's proxy:
# ALLOWED_ORIGINS=dassrebar.com,www.dassrebar.com
# Set to false only when testing a production build over plain http on a non-localhost address:
# COOKIE_SECURE=false
