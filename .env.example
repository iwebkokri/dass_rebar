# Copy to .env.local for local development. On Hostinger set these in the Node.js app's
# "Environment variables" panel. Everything is optional — the defaults work out of the box.

# ---- Where the database and uploaded files live -------------------------------------------
# Default: ./data inside the project. On the server, point this OUTSIDE the app folder so a
# redeploy can never overwrite your content, e.g.  DATA_DIR=/home/u123456/dassrebar-data
# DATA_DIR=

# ---- Public site URL (used for absolute links in metadata / emails) -----------------------
# SITE_URL=https://dassrebar.com

# ---- Email notifications for new form submissions (optional) ------------------------------
# Easiest: set it up in Studio CMS > Email (the server, the From address and who receives leads; the password is stored
# encrypted). The lines below are only a FALLBACK used while that page has no mail server saved.
# Create a mailbox in hPanel (Emails) and use its details. Recipients: Studio CMS > Email (or NOTIFY_EMAIL here).
# NOTIFY_EMAIL=sales@yourdomain.com
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=forms@yourdomain.com
# SMTP_PASS=
# MAIL_FROM="Dass Rebar <forms@yourdomain.com>"

# Key used to encrypt the saved SMTP password and Lead Manager address. Optional: without it a random key file is created in
# DATA_DIR/private/ (move that folder together with the database).
# APP_SECRET=

# ---- Lead Manager (optional; every enquiry is also sent to your lead-management software) ---
# Easiest: Studio CMS > Lead Manager. These two are only a FALLBACK used while nothing is saved there.
# The address contains a secret token — keep it private. Example shape (placeholder, not a real address):
# LEADMANAGER_URL=https://leadmanager.example.com/api/webhooks/custom/<token>
# LEADMANAGER_KEY=            # optional API key; the Authorization header is sent only when this is set
# Local testing ONLY (allows http:// and local addresses). Never set this on a live site:
# LEADMANAGER_ALLOW_INSECURE=1

# ---- Only if needed ------------------------------------------------------------------------
# If saving in Studio CMS fails with "Invalid Server Actions request" behind the host's proxy:
# ALLOWED_ORIGINS=dassrebar.com,www.dassrebar.com
# Set to false only when testing a production build over plain http on a non-localhost address:
# COOKIE_SECURE=false
